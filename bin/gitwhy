#!/usr/bin/env bash
set -euo pipefail

# gitwhy - explain how a line or range reached its current form with git log -L.

readonly PROG="${0##*/}"
readonly VERSION="0.1.0"
readonly RULE='────────────────────────────────────────────────────────────'

max_count=""
no_patch=0
reverse=0
target=""
declare -a tracked_files=()

usage() {
  cat <<'USAGE'
Usage:
  gitwhy [options] FILE:LINE
  gitwhy [options] FILE:START-END
  gitwhy [options]

Options:
  -n, --max-count N  Show at most N commits
      --no-patch     Show commit metadata only
      --reverse      Show oldest changes first
      --version      Show version
  -h, --help         Show this help

Input:
  LINE, START, and END must be positive integers, and START must not exceed END.
  FILE may be a repository-relative path, basename, or unique path suffix.
  With no FILE argument, choose a tracked file and then enter a line or range.
  fzf is used for file selection when available; otherwise a numbered menu is shown.

Requirements:
  Bash and Git. fzf is optional for interactive file selection.

Examples:
  gitwhy src/app.ts:42
  gitwhy app.ts:42
  gitwhy src/app.ts:40-60
  gitwhy --max-count 5 app.ts:42
USAGE
}

die() {
  printf '%s: %s\n' "$PROG" "$*" >&2
  exit 1
}

has_cmd() {
  command -v "$1" >/dev/null 2>&1
}

is_positive_integer() {
  [[ "$1" =~ ^[0-9]+$ && "$1" =~ [1-9] ]]
}

normalize_integer() {
  local value="$1"

  while [[ ${#value} -gt 1 && "$value" == 0* ]]; do
    value="${value#0}"
  done
  printf '%s' "$value"
}

integer_is_less_than_or_equal() {
  local left right

  left="$(normalize_integer "$1")"
  right="$(normalize_integer "$2")"

  if (( ${#left} != ${#right} )); then
    (( ${#left} < ${#right} ))
  else
    [[ "$left" == "$right" || "$left" < "$right" ]]
  fi
}

set_target() {
  [[ -z "$target" ]] || die "only one FILE:LINE argument may be specified"
  target="$1"
}

parse_target() {
  local input="$1"
  local output_file_var="$2"
  local output_start_var="$3"
  local output_end_var="$4"
  local parsed_file parsed_start parsed_end

  if [[ "$input" =~ ^(.+):([0-9]+)(-([0-9]+))?$ ]]; then
    parsed_file="${BASH_REMATCH[1]}"
    parsed_start="${BASH_REMATCH[2]}"
    parsed_end="${BASH_REMATCH[4]:-${BASH_REMATCH[2]}}"
  else
    die "invalid input: expected FILE:LINE or FILE:START-END"
  fi

  is_positive_integer "$parsed_start" || die "line numbers must be positive integers"
  is_positive_integer "$parsed_end" || die "line numbers must be positive integers"
  integer_is_less_than_or_equal "$parsed_start" "$parsed_end" ||
    die "invalid range: START must not exceed END"

  parsed_start="$(normalize_integer "$parsed_start")"
  parsed_end="$(normalize_integer "$parsed_end")"
  printf -v "$output_file_var" '%s' "$parsed_file"
  printf -v "$output_start_var" '%s' "$parsed_start"
  printf -v "$output_end_var" '%s' "$parsed_end"
}

load_tracked_files() {
  mapfile -d '' -t tracked_files < <(git -C "$repo_root" ls-files -z)
  (( ${#tracked_files[@]} > 0 )) || die "the repository has no tracked files"
}

resolve_file() {
  local query="$1"
  local output_var="$2"
  local path
  local -a matches=()

  query="${query#./}"
  if [[ "$query" == "$repo_root"/* ]]; then
    query="${query#"$repo_root"/}"
  fi

  for path in "${tracked_files[@]}"; do
    if [[ "$path" == "$query" ]]; then
      printf -v "$output_var" '%s' "$path"
      return
    fi
  done

  for path in "${tracked_files[@]}"; do
    if [[ "$path" == */"$query" ]]; then
      matches+=("$path")
    fi
  done

  case "${#matches[@]}" in
    0)
      die "no tracked file matched \"$query\""
      ;;
    1)
      printf -v "$output_var" '%s' "${matches[0]}"
      ;;
    *)
      printf '%s: multiple files matched "%s"\n\n' "$PROG" "$query" >&2
      for path in "${matches[@]}"; do
        printf '  %s\n' "$path" >&2
      done
      printf '\nSpecify a longer path.\n' >&2
      exit 1
      ;;
  esac
}

choose_file() {
  local output_var="$1"
  local choice path
  local -a selection=()
  local index

  [[ -t 0 ]] || die "interactive mode requires a terminal; provide FILE:LINE instead"

  if has_cmd fzf; then
    mapfile -d '' -t selection < <(
      printf '%s\0' "${tracked_files[@]}" |
        fzf --read0 --print0 --prompt='gitwhy file> '
    )
    (( ${#selection[@]} > 0 )) || die "file selection cancelled"
    printf -v "$output_var" '%s' "${selection[0]}"
    return
  fi

  printf '%s: select a tracked file:\n' "$PROG" >&2
  for ((index = 0; index < ${#tracked_files[@]}; index++)); do
    printf '  %d) %s\n' "$((index + 1))" "${tracked_files[index]}" >&2
  done
  printf 'File number: ' >&2
  IFS= read -r choice || die "could not read interactive input"
  is_positive_integer "$choice" || die "file number must be a positive integer"
  choice="$(normalize_integer "$choice")"
  integer_is_less_than_or_equal "$choice" "${#tracked_files[@]}" ||
    die "file number is out of range"
  path="${tracked_files[choice - 1]}"
  printf -v "$output_var" '%s' "$path"
}

prompt_for_range() {
  local output_var="$1"
  local value

  printf 'Line or range (for example, 42 or 40-60): ' >&2
  IFS= read -r value || die "could not read interactive input"
  [[ -n "$value" ]] || die "line or range is required"
  printf -v "$output_var" '%s' "$value"
}

render_log() {
  local use_color="$1"
  local line payload hash date author subject
  local first_commit=1
  local record_separator=$'\036'
  local field_separator=$'\037'

  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$line" == "$record_separator"* ]]; then
      payload="${line#"$record_separator"}"
      IFS="$field_separator" read -r hash date author subject <<< "$payload"
      if (( first_commit )); then
        first_commit=0
      else
        printf '\n%s\n\n' "$RULE"
      fi
      if (( use_color )); then
        printf '● \033[1;33m%s\033[0m  %s  %s\n' "$hash" "$date" "$author"
      else
        printf '● %s  %s  %s\n' "$hash" "$date" "$author"
      fi
      printf '  %s\n' "$subject"
    else
      printf '%s\n' "$line"
    fi
  done
}

while (( $# > 0 )); do
  case "$1" in
    -n|--max-count)
      (( $# >= 2 )) || die "$1 requires a value"
      max_count="$2"
      shift
      ;;
    --max-count=*)
      max_count="${1#*=}"
      ;;
    -n[0-9]*)
      max_count="${1#-n}"
      ;;
    --no-patch)
      no_patch=1
      ;;
    --reverse)
      reverse=1
      ;;
    --version)
      printf '%s %s\n' "$PROG" "$VERSION"
      exit 0
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      while (( $# > 0 )); do
        set_target "$1"
        shift
      done
      break
      ;;
    -*)
      die "unknown option: $1 (see --help)"
      ;;
    *)
      set_target "$1"
      ;;
  esac
  shift
done

if [[ -n "$max_count" ]]; then
  is_positive_integer "$max_count" || die "--max-count must be a positive integer"
  max_count="$(normalize_integer "$max_count")"
fi

has_cmd git || die "git is required"
repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" ||
  die "the current directory is not inside a Git work tree"
readonly repo_root
load_tracked_files

file_query=""
start_line=""
end_line=""
resolved_file=""
line_input=""

if [[ -n "$target" ]]; then
  parse_target "$target" file_query start_line end_line
  resolve_file "$file_query" resolved_file
else
  choose_file resolved_file
  prompt_for_range line_input
  parse_target "$resolved_file:$line_input" file_query start_line end_line
fi

display_range="$start_line"
if [[ "$start_line" != "$end_line" ]]; then
  display_range+="-$end_line"
fi

use_color=0
if [[ -t 1 && -z "${NO_COLOR:-}" && "${TERM:-dumb}" != "dumb" ]]; then
  use_color=1
fi

printf '%s:%s\n%s\n\n' "$resolved_file" "$display_range" "$RULE"

git_args=(
  --no-pager log
  --no-ext-diff
  "-L${start_line},${end_line}:${resolved_file}"
  --date=short
  --format=$'\036%h\037%ad\037%an\037%s'
)
[[ -z "$max_count" ]] || git_args+=("--max-count=$max_count")
(( no_patch == 0 )) || git_args+=(--no-patch)
(( reverse == 0 )) || git_args+=(--reverse)

set +e
git -C "$repo_root" "${git_args[@]}" | render_log "$use_color"
pipeline_status=("${PIPESTATUS[@]}")
set -e

if (( pipeline_status[0] != 0 )); then
  die "git could not trace ${resolved_file}:${display_range}"
fi
(( pipeline_status[1] == 0 )) || exit "${pipeline_status[1]}"
